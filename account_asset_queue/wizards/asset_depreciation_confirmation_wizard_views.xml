<?xml version="1.0" encoding="utf-8" ?>
<odoo>
<record id="view_asset_depreciation_confirmation_queue_wizard" model="ir.ui.view">
    <field name="name">asset.depreciation.confirmation.wizard</field>
    <field name="model">asset.depreciation.confirmation.wizard</field>
    <field
            name="inherit_id"
            ref="account_asset.view_asset_depreciation_confirmation_wizard"
        />
    <field name="arch" type="xml">
        <xpath expr="//button[@name='asset_compute']" position="after">
            <button
                    string="Generate Entries with Queue"
                    name="asset_compute_queue"
                    type="object"
                    class="btn-primary"
                />
        </xpath>
    </field>
</record>

</odoo>
